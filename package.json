{
  "name": "@macrostrat/d3-timescale",
  "version": "3.0.0",
  "description": "Interactive ICS geological timescale",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./intervals.json": "./src/intervals.json",
    "./intervals.nl.json": "./src/intervals.nl.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts",
    "src/intervals.json",
    "src/intervals.nl.json",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "build:data": "node scripts/build-intervals.js",
    "demo": "npx serve",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "authors": [
    "Jules Blom",
    "John J Czaplewski"
  ],
  "license": "ISC",
  "dependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@release-it/keep-a-changelog": "^8.0.0",
    "culori": "^4.0.2",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "release-it": "^21.0.1",
    "tsdown": "^0.22.14"
  }
}
